DATABASE_URL=sqlite+aiosqlite:///./advanceself.db
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200
DEBUG=true

# Browser (Flet web) calls API from a different origin — localhost regex is enabled by default in config.
# To lock down production, set cors_origin_regex to empty and list exact origins in cors_origins.
